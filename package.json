{
  "name": "@neotolis/workflow",
  "version": "0.0.0",
  "description": "Provider-neutral development workflow for Claude Code and Codex",
  "type": "module",
  "bin": {
    "ntworkflow": "build/cli/ntworkflow.mjs"
  },
  "files": [
    "build/cli/ntworkflow.mjs"
  ],
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "npm run typecheck && npm run lint",
    "lint": "eslint .",
    "package": "node scripts/package-plugins.mjs",
    "package:verify": "node --test tests/packaging/packaging.verify.ts",
    "test": "node scripts/run-tests.mjs",
    "test:conformance": "node scripts/run-tests.mjs conformance",
    "test:e2e": "node scripts/run-tests.mjs e2e",
    "typecheck": "tsc --noEmit",
    "verify": "npm run check && npm run build && npm --offline test && npm --offline run package && npm --offline run package:verify"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "2.1.220",
    "@eslint/js": "10.0.1",
    "@openai/codex": "0.144.6",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
