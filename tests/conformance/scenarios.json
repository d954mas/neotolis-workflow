      "name": "complete intake",
      "git": true,
      "steps": [
        { "cli": ["run", "start", "--session-id", "$owner"] },
        { "cli": ["phase", "begin", "nttask", "--session-id", "$owner"] },
        {
          "write": {
            "path": ".ntworkflow/runs/NT-001/BRIEF.md",
            "fixture": "tests/fixtures/briefs/valid.md"
          }
        },
        { "cli": ["phase", "complete", "nttask", "--session-id", "$owner"] }
      ]
    },
    {
      "name": "ownership blocker and re-entry",
      "git": true,
      "steps": [
        { "cli": ["run", "start", "--session-id", "$owner"] },
        { "cli": ["phase", "begin", "nttask", "--session-id", "$owner"] },
        { "cli": ["phase", "begin", "nttask", "--session-id", "$other_owner"] },
        {
          "cli": [
            "phase", "stop", "nttask", "--session-id", "$owner",
            "--blocker", "Need fixture access."
